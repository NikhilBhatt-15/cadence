# Public URL of the app (no trailing slash). OAuth callbacks are built from this.
APP_URL=http://localhost:3000

# Postgres connection string (Neon / Supabase / local).
DATABASE_URL=postgres://user:password@host:5432/cadence

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# GitHub OAuth App: https://github.com/settings/developers
# Callback URL: {APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# "read:user" reads public repos only. Use "read:user repo" to include private repos.
GITHUB_SCOPES=read:user

# X (Twitter) OAuth 2.0 app: https://developer.x.com/en/portal/dashboard
# Type: Web App (confidential client), permissions: Read and write.
# Callback URL: {APP_URL}/api/connect/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional: LinkedIn app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect".
# Callback URL: {APP_URL}/api/connect/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202601

# Optional server-wide AI fallback for users who haven't added their own key.
# Provider: google | groq | openai | anthropic | openai-compatible (needs DEFAULT_AI_BASE_URL)
DEFAULT_AI_PROVIDER=
DEFAULT_AI_MODEL=
DEFAULT_AI_API_KEY=
DEFAULT_AI_BASE_URL=

# Self-hosting with a local model (e.g. Ollama on localhost)? Allow private base URLs.
# Leave unset on shared deployments so users can't point the server at internal hosts.
# ALLOW_PRIVATE_AI_BASE_URL=true
